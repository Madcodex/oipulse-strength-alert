{
  "manifest_version": 3,
  "name": "OIPulse Strength Alert",
  "version": "1.3.1",
  "description": "Scrape OIPulse Trending OI, alert on Strength \u00b140%, and summarize with Ollama or OpenAI.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "scripting",
    "offscreen",
    "downloads"
  ],
  "host_permissions": [
    "https://oipulse.com/*",
    "http://localhost:11434/*",
    "http://localhost:8080/*",
    "https://api.openai.com/*",
    "https://api.deepseek.com/*",
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:;"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://oipulse.com/app/options-analysis/trending-oi*"
      ],
      "js": [
        "lib/parse.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OIPulse Strength Alert",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
